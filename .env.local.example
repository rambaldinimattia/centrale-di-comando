# ─────────────────────────────────────────────────────────────
# Variabili d'ambiente Centrale di Comando
# Copia questo file in ".env.local" e compila i valori.
# Senza queste variabili l'app funziona con dati DIMOSTRATIVI.
# ─────────────────────────────────────────────────────────────

# JSON del service account Google (intero contenuto del file .json,
# su una sola riga). Vedi guida SETUP.md.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ID del Google Sheet "OMC_Sentinella"
# (la parte tra /d/ e /edit nell'URL del foglio)
SHEET_ID=

# Hash SHA-256 della password d'accesso (NON la password in chiaro).
# Generalo con:  node scripts/genera-hash.mjs "la-tua-password"
PASSWORD_HASH=
